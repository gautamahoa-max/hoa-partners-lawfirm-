rules_version = '2';

// =========================================================================
// Assumed Data Model
// =========================================================================
//
// Collection: consultations
// Document ID: auto-generated
// Fields:
//   - fullName: string (required on create, 1..150 chars) - client full name
//   - phone: string (required on create, 5..25 chars, matches '^[0-9+() .-]{5,25}$') - client phone number
//   - notes: string (required on create, 1..3000 chars) - consultation details
//   - createdAt: timestamp (required on create == request.time, immutable; legacy string 1..50 chars allowed on update)
//   - status: string (optional; must be 'new' on create; one of
//     ['new', 'contacted', 'in_progress', 'completed'] on update)
//   - source: string (optional, <= 100 chars; offline sources ['zalo', 'hotline', 'office'] require admin on create) - submission source identifier
//   - email: string (optional, <= 150 chars) - client email address
//   - topic: string (optional, <= 100 chars) - consultation topic
//   - service: string (optional, <= 100 chars) - requested legal service
//   - lang: string (optional, 'vi' | 'en' on create, <= 10 chars on update) - UI language code
//   - consentVersion: string (required for non-admin create, optional for admin manual create, immutable once set, 1..50 chars) - accepted consent document version (e.g. 'HP-PDPL-03/2026')
//   - consentAcceptedAt: timestamp | string (required for non-admin create, optional for admin manual create, immutable once set, == request.time or ISO 8601 string 20..50 chars) - timestamp when visitor checked/confirmed consent
//   - consentSeq: int (required for non-admin create, paired with consentNumber, immutable once set, 1..1000000) - sequential consent number for the year
//   - consentNumber: string (required for non-admin create, paired with consentSeq, immutable once set, 1..50 chars, matches '^[0-9]{2,6}/20[2-9][0-9]/TCT-HCS$') - formatted consent reference number (e.g. '01/2026/TCT-HCS')
//   - lawyerNotes: string (optional, admin update only, <= 5000 chars)
//   - updatedAt: timestamp | string (optional, admin update only, <= 50 chars if string)
//   - updatedBy: string (optional, admin update only, <= 150 chars)
//
// Collection: counters
// Document ID: consent_YYYY (matches '^consent_20[2-9][0-9]$', e.g. 'consent_2026')
// Fields:
//   - count: int (required; == 1 on visitor create, == prev + 1 on visitor update, 0..1000000; admin syncConsentCounterFloor may write partial { count: int }) - sequential counter value
//   - lastConsultationId: string (required for visitor create/update, optional for admin writes, 1..128 chars; must reference a new consultation created in the same transaction) - ID of the consultation that incremented the counter
//
// =========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & AUTHENTICATION
    // =========================================================================

    // Verify if the user is authenticated with Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verify if the authenticated user is an authorized attorney admin
    // Accepts Firebase Auth custom claims ('admin == true') or verified allowlisted email
    function isAdmin() {
      return isAuthenticated() && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        (
          'email' in request.auth.token &&
          'email_verified' in request.auth.token &&
          request.auth.token.email_verified == true &&
          request.auth.token.email is string &&
          (
            request.auth.token.email in ['gautamahoa@gmail.com', 'vovanhoa.bank@gmail.com'] ||
            request.auth.token.email.lower() in ['gautamahoa@gmail.com', 'vovanhoa.bank@gmail.com']
          )
        )
      );
    }

    // =========================================================================
    // CONSULTATION INQUIRIES & CONSENT COUNTER DOMAIN VALIDATORS
    // =========================================================================

    // Verify counter document ID matches yearly consent counter pattern (consent_YYYY)
    function isValidConsentCounterId(counterId) {
      return counterId.matches('^consent_20[2-9][0-9]$');
    }

    // Verify post-transaction counter state matches the consultation's claimed sequence and ID
    function isMatchingCounterState(afterCounter, seq, consultationId) {
      return afterCounter != null &&
        'count' in afterCounter &&
        'lastConsultationId' in afterCounter &&
        afterCounter.count == seq &&
        afterCounter.lastConsultationId == consultationId;
    }

    // Bind consultation consentSeq/consentNumber atomically to counters/consent_YYYY via getAfter
    function hasValidAtomicConsentCounter(data, consultationId) {
      let year = data.consentNumber.split('/')[1];
      return existsAfter(/databases/$(database)/documents/counters/$('consent_' + year)) &&
        isMatchingCounterState(
          getAfter(/databases/$(database)/documents/counters/$('consent_' + year)).data,
          data.consentSeq,
          consultationId
        );
    }

    // Validates consultation inquiry documents created by public visitors (PDPL consent required)
    // or authorized admins (offline manual leads allowed without consent fields, or full consent)
    function isValidConsultationCreate(data, consultationId) {
      return
        // 1. Mandatory schema bounds & required fields
        data.keys().hasAll(['fullName', 'phone', 'notes', 'createdAt']) &&
        data.keys().hasOnly([
          'fullName',
          'phone',
          'notes',
          'createdAt',
          'status',
          'source',
          'email',
          'topic',
          'service',
          'lang',
          'consentVersion',
          'consentAcceptedAt',
          'consentSeq',
          'consentNumber'
        ]) &&

        // 2. Strict type safety, format, and character limits
        data.fullName is string &&
        data.fullName.size() >= 1 &&
        data.fullName.size() <= 150 &&

        data.phone is string &&
        data.phone.size() >= 5 &&
        data.phone.size() <= 25 &&
        data.phone.matches('^[0-9+() .-]{5,25}$') &&

        data.notes is string &&
        data.notes.size() >= 1 &&
        data.notes.size() <= 3000 &&

        // 3. createdAt must be serverTimestamp() (equals request.time)
        data.createdAt is timestamp &&
        data.createdAt == request.time &&

        // 4. Optional fields validation (creates can only use 'new' status if provided)
        (!('status' in data) || (data.status is string && data.status == 'new')) &&
        (!('source' in data) || (data.source is string && data.source.size() <= 100)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('topic' in data) || (data.topic is string && data.topic.size() <= 100)) &&
        (!('service' in data) || (data['service'] is string && data['service'].size() <= 100)) &&
        (!('lang' in data) || (data.lang is string && data.lang in ['vi', 'en'])) &&
        (!('consentVersion' in data) || (data.consentVersion is string && data.consentVersion.size() >= 1 && data.consentVersion.size() <= 50)) &&
        (
          !('consentAcceptedAt' in data) ||
          (data.consentAcceptedAt is timestamp && data.consentAcceptedAt == request.time) ||
          (
            data.consentAcceptedAt is string &&
            data.consentAcceptedAt.size() >= 20 &&
            data.consentAcceptedAt.size() <= 50 &&
            data.consentAcceptedAt.matches('^20[2-9][0-9]-[0-1][0-9]-[0-3][0-9]T[0-2][0-9]:[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-][0-2][0-9]:[0-5][0-9])$')
          )
        ) &&

        // 5. Public visitors must not spoof offline manual sources and must include complete PDPL consent proof;
        // admins may create offline manual leads without consent fields or records with full consent proof
        (
          (
            !isAdmin() &&
            (!('source' in data) || !(data.source in ['zalo', 'hotline', 'office'])) &&
            'consentVersion' in data &&
            'consentAcceptedAt' in data &&
            'consentSeq' in data &&
            'consentNumber' in data
          ) ||
          (
            isAdmin() &&
            (
              (
                !('consentVersion' in data) &&
                !('consentAcceptedAt' in data) &&
                !('consentSeq' in data) &&
                !('consentNumber' in data)
              ) ||
              (
                'consentVersion' in data &&
                'consentAcceptedAt' in data &&
                'consentSeq' in data &&
                'consentNumber' in data
              )
            )
          )
        ) &&

        // 6. Consent numbering fields must appear together and bind atomically to counters/consent_YYYY
        (('consentSeq' in data) == ('consentNumber' in data)) &&
        (
          !('consentSeq' in data) ||
          (
            data.consentSeq is int &&
            data.consentSeq >= 1 &&
            data.consentSeq <= 1000000 &&
            data.consentNumber is string &&
            data.consentNumber.size() >= 1 &&
            data.consentNumber.size() <= 50 &&
            data.consentNumber.matches('^[0-9]{2,6}/20[2-9][0-9]/TCT-HCS$') &&
            hasValidAtomicConsentCounter(data, consultationId)
          )
        );
    }

    // Validates consultation inquiry updates performed by authorized admins
    function isValidConsultationUpdate(data, existingData) {
      return
        // 1. Strict schema enforcement (no extraneous fields)
        data.keys().hasOnly([
          'fullName',
          'phone',
          'notes',
          'createdAt',
          'status',
          'source',
          'email',
          'topic',
          'service',
          'lang',
          'consentVersion',
          'consentAcceptedAt',
          'consentSeq',
          'consentNumber',
          'lawyerNotes',
          'updatedAt',
          'updatedBy'
        ]) &&

        // 2. Creation timestamp is immutable once set
        (
          !('createdAt' in existingData) ||
          ('createdAt' in data && data.createdAt == existingData.createdAt)
        ) &&
        (
          !('createdAt' in data) ||
          data.createdAt is timestamp ||
          (data.createdAt is string && data.createdAt.size() >= 1 && data.createdAt.size() <= 50)
        ) &&

        // 3. Preserve core fields if already present and enforce type/size bounds
        (!('fullName' in existingData) || 'fullName' in data) &&
        (!('fullName' in data) || (data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 150)) &&

        (!('phone' in existingData) || 'phone' in data) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 25)) &&

        (!('notes' in existingData) || 'notes' in data) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() >= 1 && data.notes.size() <= 3000)) &&

        (!('source' in data) || (data.source is string && data.source.size() <= 100)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('topic' in data) || (data.topic is string && data.topic.size() <= 100)) &&
        (!('service' in data) || (data['service'] is string && data['service'].size() <= 100)) &&
        (!('lang' in data) || (data.lang is string && data.lang.size() <= 10)) &&

        // 4. Consent evidence fields are immutable once set (Law 91/2025/QH15 Art. 9.3)
        (
          !('consentVersion' in existingData) ||
          ('consentVersion' in data && data.consentVersion == existingData.consentVersion)
        ) &&
        (!('consentVersion' in data) || (data.consentVersion is string && data.consentVersion.size() >= 1 && data.consentVersion.size() <= 50)) &&
        (
          !('consentAcceptedAt' in existingData) ||
          ('consentAcceptedAt' in data && data.consentAcceptedAt == existingData.consentAcceptedAt)
        ) &&
        (
          !('consentAcceptedAt' in data) ||
          data.consentAcceptedAt is timestamp ||
          (data.consentAcceptedAt is string && data.consentAcceptedAt.size() >= 1 && data.consentAcceptedAt.size() <= 50)
        ) &&
        (
          !('consentSeq' in existingData) ||
          ('consentSeq' in data && data.consentSeq == existingData.consentSeq)
        ) &&
        (
          !('consentSeq' in data) ||
          (data.consentSeq is int && data.consentSeq >= 1 && data.consentSeq <= 1000000)
        ) &&
        (
          !('consentNumber' in existingData) ||
          ('consentNumber' in data && data.consentNumber == existingData.consentNumber)
        ) &&
        (
          !('consentNumber' in data) ||
          (
            data.consentNumber is string &&
            data.consentNumber.size() >= 1 &&
            data.consentNumber.size() <= 50 &&
            data.consentNumber.matches('^[0-9]{2,6}/20[2-9][0-9]/TCT-HCS$')
          )
        ) &&

        // 5. Admin workflow & audit fields validation
        (!('status' in data) || (data.status is string && data.status in ['new', 'contacted', 'in_progress', 'completed'])) &&
        (!('lawyerNotes' in data) || (data.lawyerNotes is string && data.lawyerNotes.size() <= 5000)) &&
        (
          !('updatedAt' in data) ||
          data.updatedAt is timestamp ||
          (data.updatedAt is string && data.updatedAt.size() <= 50)
        ) &&
        (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 150));
    }

    // Validates admin counter synchronization writes (allows partial { count: int } such as syncConsentCounterFloor)
    function isValidAdminCounterWrite(data) {
      return data.keys().hasAll(['count']) &&
        data.keys().hasOnly(['count', 'lastConsultationId']) &&
        data.count is int &&
        data.count >= 0 &&
        data.count <= 1000000 &&
        (
          !('lastConsultationId' in data) ||
          (
            data.lastConsultationId is string &&
            data.lastConsultationId.size() >= 1 &&
            data.lastConsultationId.size() <= 128
          )
        );
    }

    // Validates visitor counter payload shape and verifies lastConsultationId is a newly created consultation
    function isValidVisitorCounterPayload(data) {
      return data.keys().hasOnly(['count', 'lastConsultationId']) &&
        data.keys().hasAll(['count', 'lastConsultationId']) &&
        data.count is int &&
        data.count >= 1 &&
        data.count <= 1000000 &&
        data.lastConsultationId is string &&
        data.lastConsultationId.size() >= 1 &&
        data.lastConsultationId.size() <= 128 &&
        data.lastConsultationId != '.' &&
        data.lastConsultationId != '..' &&
        data.lastConsultationId.split('/').size() == 1 &&
        !exists(/databases/$(database)/documents/consultations/$(data.lastConsultationId)) &&
        existsAfter(/databases/$(database)/documents/consultations/$(data.lastConsultationId));
    }

    // Validates counter document creation scoped strictly to consent_YYYY
    function isValidCounterCreate(counterId, data) {
      return isValidConsentCounterId(counterId) &&
        (
          (isAdmin() && isValidAdminCounterWrite(data)) ||
          (
            'count' in data &&
            data.count is int &&
            data.count == 1 &&
            isValidVisitorCounterPayload(data)
          )
        );
    }

    // Validates counter document update scoped strictly to consent_YYYY
    function isValidCounterUpdate(counterId, data, existingData) {
      return isValidConsentCounterId(counterId) &&
        (
          (isAdmin() && isValidAdminCounterWrite(data)) ||
          (
            'count' in data &&
            data.count is int &&
            'count' in existingData &&
            existingData.count is int &&
            data.count == existingData.count + 1 &&
            isValidVisitorCounterPayload(data)
          )
        );
    }

    // =========================================================================
    // COLLECTION RULES
    // =========================================================================

    // Consultations collection (Legal consultation inquiries from website visitors)
    match /consultations/{consultationId} {
      // Public visitors can submit inquiries subject to strict payload validation
      allow create: if isValidConsultationCreate(request.resource.data, consultationId);

      // Only authenticated admin lawyers can read (list & get inquiries)
      allow read: if isAdmin();

      // Only authenticated admin lawyers can update (status, lawyerNotes, audit fields)
      allow update: if isAdmin() && isValidConsultationUpdate(request.resource.data, resource.data);

      // Only authenticated admin lawyers can delete consultation records
      allow delete: if isAdmin();
    }

    // Counters collection (Atomic sequential numbering for Consent Letters: consent_YYYY)
    match /counters/{counterId} {
      // Single-document read allowed for matching consent_YYYY counters so visitors
      // can preview the next reference number and execute atomic counter transactions
      // shortcut: client-side atomic consent transaction requires counter get on Spark plan; lock to isAdmin() and enforce request.app != null once intake moves to a server-side endpoint
      allow get: if isValidConsentCounterId(counterId) || isAdmin();

      // Collection queries restricted to authorized admin lawyers
      allow list: if isAdmin();

      // Scoped to consent_YYYY: visitors initialize/increment atomically with a new consultation;
      // admins may also sync floor counts via partial { count: int } writes
      allow create: if isValidCounterCreate(counterId, request.resource.data);
      allow update: if isValidCounterUpdate(counterId, request.resource.data, resource.data);

      // Counter documents cannot be deleted from client SDKs
      allow delete: if false;
    }

    // =========================================================================
    // DEFAULT DENY RULE
    // =========================================================================

    // Deny all reads and writes for any other document or collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
